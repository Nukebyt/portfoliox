# Public (client) Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=portfolio-images

# Supabase service role key (server-only). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=

# Admin session secret (32+ chars). Used to sign admin session tokens.
ADMIN_SESSION_SECRET=replace-with-a-strong-random-string
ADMIN_COOKIE_NAME=portfolio_admin_session
ADMIN_COOKIE_MAX_AGE_SECONDS=604800

# Form handling (Formspree) and contact
NEXT_PUBLIC_FORMSPREE_ACTION=
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
